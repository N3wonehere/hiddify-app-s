diff --git a/v2/config/lan_sharing_test.go b/v2/config/lan_sharing_test.go
new file mode 100644
--- /dev/null
+++ b/v2/config/lan_sharing_test.go
@@ -0,0 +1,128 @@
+package config
+
+import (
+	"net/netip"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+const testCredentialVerifier = "$hiddify-pbkdf2-sha256$100000$AAECAwQFBgcICQoLDA0ODw$Z88nxzJPgIWUeaXuZ--Hvm7oJltx0z9QUHrieYhh1qM"
+
+func TestLANSharingFailsClosedWithoutVerifier(t *testing.T) {
+	hopt := &HiddifyOptions{
+		InboundOptions: InboundOptions{LANSharingPassword: "plaintext"},
+		RouteOptions:   RouteOptions{AllowConnectionFromLAN: true},
+	}
+	if users := lanSharingUsers(hopt); users != nil {
+		t.Fatalf("expected no LAN users for a plaintext credential, got %d", len(users))
+	}
+}
+
+func TestLANSharingUsesCredentialVerifier(t *testing.T) {
+	hopt := &HiddifyOptions{
+		InboundOptions: InboundOptions{LANSharingPassword: testCredentialVerifier},
+		RouteOptions:   RouteOptions{AllowConnectionFromLAN: true},
+	}
+	users := lanSharingUsers(hopt)
+	if len(users) != 1 {
+		t.Fatalf("expected one LAN user, got %d", len(users))
+	}
+	if users[0].Username != testCredentialVerifier || users[0].Password != "" {
+		t.Fatal("LAN credentials were not passed to the verifier-only authenticator")
+	}
+}
+
+func TestLANSharingDoesNotAuthenticateLoopbackMode(t *testing.T) {
+	hopt := &HiddifyOptions{
+		InboundOptions: InboundOptions{LANSharingPassword: testCredentialVerifier},
+		RouteOptions:   RouteOptions{AllowConnectionFromLAN: false},
+	}
+	if users := lanSharingUsers(hopt); users != nil {
+		t.Fatalf("expected no LAN users while LAN sharing is disabled, got %d", len(users))
+	}
+}
+
+func TestLANSharingInboundBindAndAuthentication(t *testing.T) {
+	for _, testCase := range []struct {
+		name         string
+		verifier     string
+		externalBind bool
+		userCount    int
+	}{
+		{
+			name:         "valid verifier binds externally with authentication",
+			verifier:     testCredentialVerifier,
+			externalBind: true,
+			userCount:    1,
+		},
+		{
+			name:         "missing verifier fails closed to loopback",
+			externalBind: false,
+			userCount:    0,
+		},
+		{
+			name:         "plaintext verifier fails closed to loopback",
+			verifier:     "plaintext",
+			externalBind: false,
+			userCount:    0,
+		},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			hopt := &HiddifyOptions{
+				InboundOptions: InboundOptions{
+					MixedPort:          12334,
+					DirectPort:         12337,
+					LANSharingPassword: testCase.verifier,
+				},
+				RouteOptions: RouteOptions{AllowConnectionFromLAN: true},
+			}
+			var options option.Options
+			setInbound(&options, hopt)
+
+			mixedCount := 0
+			directCount := 0
+			for _, inbound := range options.Inbounds {
+				switch inbound.Type {
+				case C.TypeMixed:
+					mixedCount++
+					mixedOptions, loaded := inbound.Options.(*option.HTTPMixedInboundOptions)
+					if !loaded || mixedOptions.Listen == nil {
+						t.Fatal("mixed inbound is missing listen options")
+					}
+					listenAddress := netip.Addr(*mixedOptions.Listen)
+					if testCase.externalBind != listenAddress.IsUnspecified() {
+						t.Fatalf("unexpected mixed listen address: %s", listenAddress)
+					}
+					if !testCase.externalBind && !listenAddress.IsLoopback() {
+						t.Fatalf("insecure non-loopback mixed fallback: %s", listenAddress)
+					}
+					if len(mixedOptions.Users) != testCase.userCount {
+						t.Fatalf(
+							"expected %d authentication users, got %d",
+							testCase.userCount,
+							len(mixedOptions.Users),
+						)
+					}
+				case C.TypeDirect:
+					directCount++
+					directOptions, loaded := inbound.Options.(*option.DirectInboundOptions)
+					if !loaded || directOptions.Listen == nil {
+						t.Fatal("direct inbound is missing listen options")
+					}
+					listenAddress := netip.Addr(*directOptions.Listen)
+					if !listenAddress.IsLoopback() {
+						t.Fatalf("unauthenticated direct inbound escaped loopback: %s", listenAddress)
+					}
+				}
+			}
+			if mixedCount == 0 {
+				t.Fatal("no mixed inbound was generated")
+			}
+			if directCount == 0 {
+				t.Fatal("no direct inbound was generated")
+			}
+		})
+	}
+}
